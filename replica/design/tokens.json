{
  "_about": "Design tokens for Tabmate. Role names match Splitwise's own system (bg/surface/border/text/accent/...), structurally — the accent hue (indigo-violet) is Tabmate's own, a different family from Splitwise's teal/mint, finalized in replica-brand (see replica/brand.md). Check after every change: python3 contrast.py replica/design/tokens.json",
  "color": {
    "bg": "#ffffff",
    "surface": "#f6f7f9",
    "border": "#e3e6ea",
    "border-input": "#8a93a1",
    "text": "#1f2430",
    "text-muted": "#6b7280",
    "accent": "#5b5fef",
    "accent-strong": "#4338ca",
    "on-accent": "#ffffff",
    "danger": "#dc2626",
    "success": "#15803d",
    "warning": "#b45309"
  },
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["on-accent", "accent"],
    ["on-accent", "accent-strong"],
    ["accent", "bg"],
    ["danger", "bg"],
    ["success", "bg"],
    ["warning", "bg"],
    ["border-input", "bg", "ui"]
  ],
  "font": {
    "sans": "Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
    "display": "Manrope, Inter, system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "type": {
    "xs": {"size": 12, "line": 16, "weight": 500},
    "sm": {"size": 14, "line": 20, "weight": 400},
    "base": {"size": 16, "line": 24, "weight": 400},
    "lg": {"size": 20, "line": 28, "weight": 600},
    "xl": {"size": 28, "line": 34, "weight": 700},
    "display": {"size": 40, "line": 44, "weight": 700}
  },
  "space": [0, 4, 8, 12, 16, 24, 32, 48, 64],
  "radius": {"sm": 6, "md": 10, "lg": 16, "pill": 999},
  "shadow": {
    "card": "0 1px 2px rgba(16,24,40,.06), 0 1px 3px rgba(16,24,40,.10)",
    "pop": "0 12px 32px rgba(16,24,40,.16)"
  },
  "motion": {"fast": "120ms", "base": "200ms", "ease": "cubic-bezier(.2,.8,.2,1)"}
}
