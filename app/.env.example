# Copy to .env.local for local runs (`npx expo start`).
# For APK builds these must ALSO be set as EAS environment variables — see SETUP.md.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: link to download the APK, included in friend/group invite messages
EXPO_PUBLIC_APP_DOWNLOAD_URL=
